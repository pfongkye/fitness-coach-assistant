# ==============================================================================
# AI Expert Fitness Coach Assistant - Environment Configuration (.env.example)
# Copy this file to .env and fill in your credentials.
# ==============================================================================

# Gemini / Google AI Studio Configuration
# Get your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FAST_MODEL=gemini-3.6-flash

# Google Cloud Platform Settings
GCP_PROJECT=fitness-coach-dev
GCP_REGION=us-central1

# Cloud KMS & Security
KMS_MASTER_KEY=fitness-coach-secret-master-kek-32b!
KMS_KEY_RING=fitness-vault-ring
KMS_KEY=user-data-key

# Redis Session Storage (Optional for local, used on Cloud Run)
REDIS_URL=redis://localhost:6379

# Weather API (Optional - defaults to Open-Meteo free API if empty)
OPENWEATHER_API_KEY=
WEATHER_PROVIDER=open-meteo

# Server Port
PORT=8080
